<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Novely.Mapper</PackageId>
		<Version>8.0.0</Version>
		<Authors>Mathias Hue</Authors>
		<Company>Novely</Company>
		<Description>NovelyMapper : un mapper léger et fluent pour .NET permettant de créer facilement des mappings entre objets, avec support des profils.</Description>
		<PackageTags>mapping;automapper;object-mapper;fluent-mapping;DI;dotnet;C#</PackageTags>
		<RepositoryUrl>https://github.com/HueMathias/Novely.Mapper</RepositoryUrl>
		<PackageOutputPath>publish</PackageOutputPath>
		<PackageLicenseFile>assets\LICENSE.txt</PackageLicenseFile>
		<PackageIcon>assets\icon.png</PackageIcon>
		<PackageReadmeFile>assets\README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup>
		<None Update="assets\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="assets\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="assets\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
